<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  
  <mapper namespace="com.shelter.app.member.MemberDAO">
	<resultMap type="MemberVO" id="detailResult">
		<id column="member_id" property="memberId"/>
		<result column="username" property="username"/>
		<result column="password" property="password"/>
		<result column="name" property="name"/>
		<result column="gender" property="gender"/>
		<result column="age" property="age"/>
		<result column="email" property="email"/>
		<result column="phone" property="phone"/>
		<result column="has_pet" property="hasPet"/>
		
		<collection property="roleVOs" javaType="java.util.List" ofType="RoleVO">
			<id column="member_author_id" property="memberAuthorId"/>
			<result column="author_id" property="authorId"/>
		</collection>
	</resultMap>
  	
  	<select id="login" parameterType="MemberVO" resultMap="detailResult">
  		SELECT *
		FROM member m
		JOIN member_author ma USING(member_id)
		JOIN author a USING(author_id)
		WHERE m.username = #{username}
			  AND m.password = #{password};
  	</select>
  	
  	<insert id="insertMember" parameterType="MemberVO" useGeneratedKeys="true" keyProperty="memberId">
  		INSERT INTO member (username, password, name, gender, age, email, phone, has_pet)
		VALUES (
		#{username}
		,#{password}
		,#{name}
		,#{gender}
		,#{age}
		,#{email}
		,#{phone}
		,
		<choose>
			<when test="hasPet == null || hasPet == 0">
				0
			</when>
			<otherwise>
				1
			</otherwise>
		</choose>
		)
  	</insert>
  	
  	<insert id="insertRole" parameterType="RoleVO">
	INSERT INTO member_author (member_id, author_id)
	VALUES (#{memberId}, #{authorId})
  	</insert>
  </mapper>